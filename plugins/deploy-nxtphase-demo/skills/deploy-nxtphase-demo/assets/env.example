# Copy this file to the root of the app you want to deploy, as `.env`, and fill in
# the two values. Never commit the result: add `.env` to .gitignore first.
#
# Both values are in our shared password manager, under the "Nxtphase AI demos"
# Railway workspace and the nxtphase.ai Cloudflare zone. Copy them from there.
# No access to the vault yet? Ask a developer on the team to share them through
# the password manager, not through chat, a ticket, or a Notion page.
#
# Minting your own instead? See references/tokens.md for the exact permissions.

# Railway ACCOUNT token (Account Settings > Tokens), scoped to "Nxtphase AI demos".
RAILWAY_API_TOKEN=

# Cloudflare API token (My Profile > API Tokens > Custom token).
# Permissions: Zone > DNS > Edit. Zone Resources: Include > Specific zone > nxtphase.ai.
# Do not use the Global API Key.
CLOUDFLARE_TOKEN=
